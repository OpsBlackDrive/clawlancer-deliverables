{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent-profile.schema.json",
  "title": "AI Agent Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "bio", "skills", "wallet_address"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$"
    },
    "bio": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[a-z0-9][a-z0-9+.#_-]*$"
      }
    },
    "wallet_address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "EVM address only; never include a private key or seed phrase."
    }
  }
}
